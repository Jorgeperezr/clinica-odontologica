# ═══ PRODUCCIÓN — copiar a .env en el servidor y completar ═══
# Generar la SECRET_KEY con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SECRET_KEY=CAMBIAR-generar-clave-de-64-caracteres
DJANGO_DEBUG=False
# Dominio(s) reales del sistema, separados por coma:
DJANGO_ALLOWED_HOSTS=app.clinube.com
CSRF_TRUSTED_ORIGINS=https://app.clinube.com
CORS_ALLOWED_ORIGINS=https://app.clinube.com

# --- Base de datos (usar una contraseña fuerte y distinta a la de dev) ---
POSTGRES_DB=clinica
POSTGRES_USER=clinica
POSTGRES_PASSWORD=CAMBIAR-password-fuerte
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Seguridad TLS ---
# Con Cloudflare Tunnel: dejar False (el túnel ya fuerza HTTPS; True causa bucles).
# Con Nginx + certificado propio (certbot): poner True.
SECURE_SSL_REDIRECT=False
# Subir a 31536000 cuando el HTTPS esté estable:
SECURE_HSTS_SECONDS=3600

# --- Comunicación interna Django ↔ gateway ---
INTERNAL_SERVICE_TOKEN=CAMBIAR-otro-token-largo-aleatorio
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:8001

# --- WhatsApp / Meta (cuando la verificación de negocio esté aprobada) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# --- Archivos ---
USE_CLOUD_STORAGE=False

# --- Correo (recuperación de contraseña del personal) ---
# Sin EMAIL_HOST el correo NO sale: solo se escribe en el registro.
# Ejemplo con Gmail/Workspace: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_HOST_USER=la cuenta y EMAIL_HOST_PASSWORD=una «contraseña de
# aplicación» (no la de la cuenta).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Clinube <no-responder@clinube.com>

# --- Backups cifrados (scripts/backup.sh) ---
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# GUARDAR una copia de esta clave FUERA del servidor: sin ella el backup
# es irrecuperable.
BACKUP_PASSPHRASE=CAMBIAR-clave-de-cifrado-de-backups
