# --- Django ---
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS: agregar aquí la URL del panel/admin si se sirve detrás
# de un proxy externo (Codespaces, Cloudflare, dominio propio con TLS).
# Ejemplo Codespaces: https://tu-codespace-80.app.github.dev
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=clinica
POSTGRES_USER=clinica
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Integración interna Django <-> FastAPI ---
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:8001
INTERNAL_SERVICE_TOKEN=change-me-shared-secret

# --- Meta WhatsApp Cloud API (whatsapp-gateway) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=change-me-verify-token
META_APP_SECRET=

# --- CORS (panel web Next.js) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Cloud Storage (dejar en False para desarrollo local) ---
USE_CLOUD_STORAGE=False
GS_BUCKET_NAME=
